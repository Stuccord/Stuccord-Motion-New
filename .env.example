# -------------------------------------------------
# Supabase Configuration
# -------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_XXXXXXXXXXXXXXXX
VITE_SUPABASE_URL=$SUPABASE_URL
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXX

# -------------------------------------------------
# Security & Authentication Controls
# -------------------------------------------------
# SECURITY WARNING: ENABLE_DEV_MOCK_AUTH MUST NEVER BE SET TO true IN PRODUCTION.
# When false (default), unauthenticated server requests throw a 401 Unauthorized error.
# Set to true ONLY in local dev (NODE_ENV=development, i.e. `npm run dev`) to have requests
# without a session run as the dev user below. The dev user signs in with a real password,
# so Row Level Security still applies; the service-role key is never used for this.
ENABLE_DEV_MOCK_AUTH=false

# Dev user credentials (used ONLY when ENABLE_DEV_MOCK_AUTH=true in development).
# Generate them with: node --env-file=.env supabase/seed-dev-user.mjs  (writes .env.local)
DEV_MOCK_USER_EMAIL=dev-user@stuccord.local
DEV_MOCK_USER_PASSWORD=

# -------------------------------------------------
# Render Worker & External Services
# -------------------------------------------------
# Worker endpoint: accept either the base service URL (e.g. https://stuccord-render-worker.onrender.com)
# or the full jobs URL (e.g. https://stuccord-render-worker.onrender.com/jobs)
RENDER_WORKER_URL=https://stuccord-render-worker.onrender.com

# Server-only shared secret for signing worker dispatch and validating webhook callbacks
RENDER_WORKER_SECRET=super-secret-hmac-key

# Canonical absolute public URL used by the external worker to send progress/completion callbacks (e.g. https://app.example.com)
PUBLIC_APP_URL=http://localhost:3000

# Legacy fallback; prefer PUBLIC_APP_URL
PUBLIC_URL=http://localhost:3000

